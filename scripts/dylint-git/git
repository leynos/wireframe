#!/usr/bin/env bash
# Dylint 6.0.1 expects a local master branch after cloning rust-clippy.
# Its default branch is now main, so create the expected local ref after clone.
set -eu

if [[ "${1-}" == clone && "${2-}" == https://github.com/rust-lang/rust-clippy ]]; then
    destination="${3:?clone destination is required}"
    "${DYLINT_REAL_GIT:?}" "$@"
    exec "${DYLINT_REAL_GIT:?}" -C "$destination" branch master
fi

exec "${DYLINT_REAL_GIT:?}" "$@"
